# Orbit Gallery 环境变量模板

# 运行环境（development / production）
APP_ENV=development

# PostgreSQL 连接串
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/orbit

# JWT 密钥（至少 32 字符，生产环境请生成强随机值）
SECRET_KEY=your-super-long-secret-key-at-least-32-bytes-min

# 调试模式（生产环境务必设为 False）
DEBUG=False

# 上传文件目录（相对于项目根，.gitignore 已排除）
UPLOAD_DIR=uploads

# 静态资源 CDN 基础 URL（部署时配置，本地留空）
ASSETS_BASE_URL=

# --- 存储路径 ---
STATIC_DIR=static
IMAGES_DIR=static/images
AVATARS_DIR=static/avatars

# --- 文件大小限制 ---
MAX_IMAGE_FILE_SIZE=10485760   # 10 MB
MAX_AVATAR_SIZE=5242880        # 5 MB

# --- 缩略图尺寸 ---
THUMBNAIL_WIDTH=300
THUMBNAIL_HEIGHT=300
